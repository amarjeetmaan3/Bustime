<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:rippleColor="@color/colorPrimaryContainer"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="14dp">

        <!-- Circular Tinted Bus Badge -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_indigo">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_bus_modern"
                app:tint="@color/colorPrimary" />
        </FrameLayout>

        <!-- Center Info: Bus Service Name, Full Route Endpoints, Warm Stops/Info Pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStandBusTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans"
                android:maxLines="1"
                android:textColor="@color/textPrimary"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStandBusRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans"
                android:maxLines="1"
                android:textColor="@color/textSecondary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tvStandBusMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_warm_pill"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans"
                android:maxLines="1"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:textColor="@color/warmPillText"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Right: JetBrains Mono Passing Time + Optional Call Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStandBusTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono"
                android:gravity="end"
                android:textColor="@color/textPrimary"
                android:textSize="16.5sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnStandBusCall"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_call_circle"
                android:contentDescription="@string/call"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_call"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
