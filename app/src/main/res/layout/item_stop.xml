<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="62dp"
    android:orientation="horizontal">

    <!-- Glowing Ringed Station Node & Connecting Rail -->
    <com.bustime.app.ui.common.GlowingStopNodeView
        android:id="@+id/stopNodeView"
        android:layout_width="36dp"
        android:layout_height="match_parent" />

    <!-- Primary Stop Name + Multilingual Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="11dp"
        android:paddingEnd="8dp"
        android:paddingBottom="13dp">

        <TextView
            android:id="@+id/tvStopName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textColor="@color/textPrimary"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStopAltNames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans"
            android:maxLines="1"
            android:textColor="@color/textMuted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Right-Aligned JetBrains Mono Time + Inline Warm +1 Day Pill -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingTop="11dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/tvStopTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:gravity="end"
            android:textColor="@color/textPrimary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStopDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_warm_pill"
            android:fontFamily="@font/plus_jakarta_sans"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2.5dp"
            android:textColor="@color/warmPillText"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
